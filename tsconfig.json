{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "target": "es6",
    "lib": ["es6", "dom", "es2016", "es2017"],
    "sourceMap": true,
    "allowJs": false,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "types": ["jest"]
  },
  "include": ["index.ts", "tests"],
  "exclude": ["node_modules", "dist", "rollup.config.cjs"]
}